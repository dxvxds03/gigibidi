# --- Supabase ---
# Projekt-URL, z.B. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service-Role-Key (NUR serverseitig, niemals im Browser). Supabase > Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=

# --- Geheime Links (Permalinks) ---
# Der geheime Pfad fuer die oeffentliche Audio-Seite:  /v/<PUBLIC_SLUG>
PUBLIC_SLUG=
# Der geheime Pfad fuer den Bearbeitungsbereich:       /a/<ADMIN_SLUG>
ADMIN_SLUG=

# --- Session ---
# Zufaelliger langer String zum Signieren der Login-Cookies (z.B. `openssl rand -hex 32`)
SESSION_SECRET=

# --- Cron / Keep-alive (optional) ---
# Wenn gesetzt, muss der taegliche Cron-Aufruf diesen Bearer-Token mitschicken.
CRON_SECRET=

# --- Vercel Blob (fuer grosse Videos) ---
# Wird automatisch gesetzt, sobald in Vercel ein Blob-Store mit dem Projekt
# verbunden ist (Storage -> Create Store -> Blob). Nicht manuell eintragen.
BLOB_READ_WRITE_TOKEN=
